{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyteDeck",
  "version": "0.0.1",
  "identifier": "com.hytedeck.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HyteDeck",
        "width": 400,
        "height": 800,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
